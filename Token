pragma solidity 0.8.37;

import "@openzeppelin/contracts@5.7.0/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts@5.7.0/token/ERC20/extensions/ERC20Permit.sol";
import "@openzeppelin/contracts@5.7.0/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts@5.7.0/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts@5.7.0/access/Ownable2Step.sol";
import "@openzeppelin/contracts@5.7.0/utils/Pausable.sol";
import "@openzeppelin/contracts@5.7.0/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts@5.7.0/utils/types/Time.sol";

/// @title 1M BLOCKS MINE Token
/// @author 1M BLOCKS
/// @notice Fixed-supply ERC20 token for the 1M BLOCKS ecosystem on BNB Chain.
/// @dev
/// Security and design properties:
/// - Exactly 500,000,000 MINE are created once during deployment.
/// - No minting function exists after deployment.
/// - Total supply can only decrease through voluntary holder burns.
/// - Every holder can permanently burn tokens from their own balance.
/// - No holder can arbitrarily burn another holder's balance.
/// - EIP-2612 Permit enables signature-based approvals.
/// - Owner-operated batch airdrops are limited to 50 recipients per call.
/// - Each recipient has a 24-hour owner-airdrop cooldown.
/// - The cooldown clock uses OpenZeppelin's Time utility.
/// - All balance movements are blocked while the token is paused.
/// - Ownership transfer uses the two-step Ownable2Step mechanism.
/// - Ownership renouncement is permanently disabled.
/// - ERC20 assets accidentally transferred to this contract are recoverable.
/// - Emergency recovery cannot access balances held in arbitrary user wallets.
/// - No blacklist exists.
/// - No transfer tax exists.
/// - No hidden mint mechanism exists.
/// - No proxy or upgrade mechanism exists.
contract MINE is
    ERC20,
    ERC20Permit,
    Ownable2Step,
    Pausable,
    ReentrancyGuard
{
    using SafeERC20 for IERC20;

    // =============================================================
    //                           CONSTANTS
    // =============================================================

    /// @dev
    /// Complete initial token supply using the standard ERC20
    /// 18-decimal representation.
    uint256 private constant _INITIAL_SUPPLY =
        500_000_000 * 1e18;

    /// @dev
    /// Hard upper bound for a single owner-operated batch.
    /// This also provides a deterministic upper bound for the loop.
    uint256 private constant _MAX_AIRDROP_BATCH_SIZE =
        50;

    /// @dev
    /// Required interval between successful owner airdrops
    /// to the same recipient.
    uint256 private constant _AIRDROP_COOLDOWN =
        24 hours;

    // =============================================================
    //                             ERRORS
    // =============================================================

    /// @dev Recipient and amount arrays do not have identical lengths.
    error LenMismatch();

    /// @dev No recipients were supplied.
    error EmptyBatch();

    /// @dev The requested batch exceeds the hard recipient limit.
    error BatchSizeTooLarge();

    /// @dev A zero-address recipient was supplied.
    error InvalidRecipient();

    /// @dev The supplied recovery token address is invalid.
    error InvalidToken();

    /// @dev
    /// The recipient has already received an owner airdrop
    /// and its cooldown has not yet expired.
    error RecipientInCooldown(
        address recipient,
        uint256 nextAvailableAt
    );

    /// @dev A token operation was requested with a zero amount.
    error ZeroAmount();

    /// @dev No recoverable balance exists for the supplied ERC20 token.
    error NoTokensToWithdraw();

    /// @dev Ownership renouncement is intentionally unavailable.
    error OwnershipRenounceDisabled();

    // =============================================================
    //                            STORAGE
    // =============================================================

    /// @dev
    /// For each recipient, stores the earliest time at which another
    /// owner-operated airdrop may be received.
    ///
    /// A zero value means that the address has never received an airdrop
    /// or is otherwise immediately eligible.
    mapping(address => uint256)
        private _nextAirdropAvailable;

    // =============================================================
    //                             EVENTS
    // =============================================================

    /// @notice Emitted whenever a holder voluntarily destroys MINE.
    /// @param burner Address whose MINE balance was reduced.
    /// @param amount Amount permanently removed from circulation.
    /// @param currentTotalSupply Total token supply after the burn.
    event TokensBurned(
        address indexed burner,
        uint256 amount,
        uint256 currentTotalSupply
    );

    /// @notice Emitted for every successful recipient in a batch airdrop.
    /// @param recipient Address receiving MINE.
    /// @param amount Amount transferred to the recipient.
    /// @param nextUnlockTime Earliest time another owner airdrop is permitted.
    event Airdrop(
        address indexed recipient,
        uint256 amount,
        uint256 nextUnlockTime
    );

    /// @notice Emitted when an ERC20 asset is recovered from this contract.
    /// @param recipient Current owner receiving the recovered asset.
    /// @param token ERC20 contract whose balance was recovered.
    /// @param amount Amount recovered.
    event EmergencyTokensWithdrawn(
        address indexed recipient,
        address indexed token,
        uint256 amount
    );

    // =============================================================
    //                          CONSTRUCTOR
    // =============================================================

    /// @notice Deploys the MINE token.
    /// @dev
    /// The complete fixed supply is created in this constructor.
    ///
    /// There is deliberately no external, public, owner-only,
    /// role-based, or internal application-level mint function
    /// available after construction.
    ///
    /// The deployment address becomes the initial owner and receives
    /// the complete initial token supply.
    constructor()
        ERC20("MINE", "M")
        ERC20Permit("MINE")
        Ownable(msg.sender)
    {
        _mint(
            msg.sender,
            _INITIAL_SUPPLY
        );
    }

    // =============================================================
    //                              BURN
    // =============================================================

    /// @notice Permanently destroys MINE owned by the caller.
    /// @dev
    /// Any MINE holder may use this function.
    ///
    /// The caller can only destroy tokens held by the caller's own
    /// address. This function provides no mechanism to select another
    /// account as the burn source.
    ///
    /// ERC20's internal burn implementation decreases both the caller's
    /// balance and the global total supply.
    ///
    /// Burning is disabled while emergency pause mode is active.
    ///
    /// @param amount Amount of MINE to permanently destroy.
    function burn(
        uint256 amount
    )
        external
        whenNotPaused
    {
        if (amount == 0) {
            revert ZeroAmount();
        }

        _burn(
            msg.sender,
            amount
        );

        emit TokensBurned(
            msg.sender,
            amount,
            totalSupply()
        );
    }

    // =============================================================
    //                            AIRDROP
    // =============================================================

    /// @notice
    /// Transfers MINE from the current owner's balance to multiple
    /// recipients in one atomic transaction.
    ///
    /// @dev
    /// The batch is subject to a hard maximum of 50 recipients.
    ///
    /// The complete call reverts if any individual recipient fails
    /// validation. Solidity transaction atomicity therefore prevents
    /// partially completed batches.
    ///
    /// Each successfully processed recipient receives a new cooldown
    /// deadline before the transfer is executed.
    ///
    /// Because the cooldown state is updated during each iteration,
    /// supplying the same recipient twice in one batch causes the later
    /// occurrence to fail its cooldown check and revert the complete call.
    ///
    /// The current time is read once before entering the loop so every
    /// recipient in the same transaction receives the exact same cooldown
    /// deadline and repeated clock reads are avoided.
    ///
    /// The loop index is increased inside an unchecked block. This is safe
    /// because `len` is explicitly bounded to no more than 50 before the
    /// loop begins.
    ///
    /// Requirements:
    /// - caller must be the current owner;
    /// - token must not be paused;
    /// - arrays must have identical lengths;
    /// - batch cannot be empty;
    /// - batch cannot exceed 50 recipients;
    /// - recipient cannot be the zero address;
    /// - amount cannot be zero;
    /// - recipient cannot be inside its cooldown;
    /// - owner must have sufficient MINE.
    ///
    /// @param recipients Recipient addresses.
    /// @param amounts Token amount associated with each recipient.
    function bulkAirdrop(
        address[] calldata recipients,
        uint256[] calldata amounts
    )
        external
        onlyOwner
        whenNotPaused
    {
        uint256 len =
            recipients.length;

        if (len != amounts.length) {
            revert LenMismatch();
        }

        if (len == 0) {
            revert EmptyBatch();
        }

        if (len > _MAX_AIRDROP_BATCH_SIZE) {
            revert BatchSizeTooLarge();
        }

        address sender =
            msg.sender;

        uint256 currentTimestamp =
            uint256(Time.timestamp());

        uint256 nextUnlockTime;

        unchecked {
            // Time.timestamp() uses a uint48 clock.
            // Adding 24 hours cannot overflow uint256.
            nextUnlockTime =
                currentTimestamp +
                _AIRDROP_COOLDOWN;
        }

        uint256 i;

        while (i < len) {
            address recipient =
                recipients[i];

            uint256 amount =
                amounts[i];

            if (recipient == address(0)) {
                revert InvalidRecipient();
            }

            if (amount == 0) {
                revert ZeroAmount();
            }

            uint256 nextAvailableAt =
                _nextAirdropAvailable[recipient];

            if (
                currentTimestamp <
                nextAvailableAt
            ) {
                revert RecipientInCooldown(
                    recipient,
                    nextAvailableAt
                );
            }

            // Effects are committed before the token movement.
            // A revert later in this transaction also rolls this
            // storage change back automatically.
            _nextAirdropAvailable[recipient] =
                nextUnlockTime;

            _transfer(
                sender,
                recipient,
                amount
            );

            emit Airdrop(
                recipient,
                amount,
                nextUnlockTime
            );

            unchecked {
                // `len` is guaranteed to be <= 50.
                // Therefore this increment cannot overflow.
                ++i;
            }
        }
    }

    // =============================================================
    //                         VIEW FUNCTIONS
    // =============================================================

    /// @notice
    /// Returns the remaining owner-airdrop cooldown for an address.
    ///
    /// @dev
    /// Returns zero when the address is eligible immediately.
    ///
    /// The subtraction is performed only after proving that the stored
    /// unlock time is greater than the current time. Underflow is
    /// therefore impossible in the unchecked subtraction.
    ///
    /// @param account Address whose cooldown will be inspected.
    /// @return remainingTime Remaining cooldown duration in seconds.
    function getRemainingCooldown(
        address account
    )
        external
        view
        returns (
            uint256 remainingTime
        )
    {
        uint256 unlockTime =
            _nextAirdropAvailable[account];

        uint256 currentTimestamp =
            uint256(Time.timestamp());

        if (
            currentTimestamp >=
            unlockTime
        ) {
            return 0;
        }

        unchecked {
            return
                unlockTime -
                currentTimestamp;
        }
    }

    // =============================================================
    //                             PAUSE
    // =============================================================

    /// @notice Activates the emergency token-movement pause.
    /// @dev
    /// Only the current owner may activate the pause.
    ///
    /// Transfer enforcement is centralized in `_update`, which means
    /// ordinary transfers, transferFrom operations and burns cannot
    /// move balances while the contract is paused.
    function pause()
        external
        onlyOwner
    {
        _pause();
    }

    /// @notice Deactivates the emergency token-movement pause.
    /// @dev Only the current owner may restore normal token movement.
    function unpause()
        external
        onlyOwner
    {
        _unpause();
    }

    // =============================================================
    //                          OWNERSHIP
    // =============================================================

    /// @notice Permanently rejects ownership-renouncement attempts.
    /// @dev
    /// Ownable2Step remains available for controlled ownership
    /// transfers.
    ///
    /// Preventing renouncement ensures that the emergency pause and
    /// recovery controls can never become permanently unreachable
    /// because of an accidental renounce transaction.
    function renounceOwnership()
        public
        view
        override
        onlyOwner
    {
        revert OwnershipRenounceDisabled();
    }

    // =============================================================
    //                    EMERGENCY ERC20 RECOVERY
    // =============================================================

    /// @notice
    /// Recovers the complete balance of an ERC20 asset held by this
    /// contract address.
    ///
    /// @dev
    /// This recovery path only operates on assets whose owner is the
    /// MINE contract itself.
    ///
    /// It provides no mechanism for withdrawing ERC20 balances from
    /// arbitrary users.
    ///
    /// The supplied address must be a deployed contract.
    ///
    /// SafeERC20 is used so ERC20 implementations that return no value,
    /// return a boolean value, or otherwise follow common ERC20 transfer
    /// conventions are handled safely.
    ///
    /// ReentrancyGuard protects the external recovery path while the
    /// external token contract is being called.
    ///
    /// The current owner is cached before the transfer so ownership
    /// storage is not read repeatedly.
    ///
    /// @param tokenAddress ERC20 token contract to recover.
    function emergencyWithdrawTokens(
        address tokenAddress
    )
        external
        onlyOwner
        nonReentrant
    {
        if (
            tokenAddress == address(0) ||
            tokenAddress.code.length == 0
        ) {
            revert InvalidToken();
        }

        IERC20 token =
            IERC20(tokenAddress);

        uint256 balance =
            token.balanceOf(
                address(this)
            );

        if (balance == 0) {
            revert NoTokensToWithdraw();
        }

        address tokenOwner =
            owner();

        token.safeTransfer(
            tokenOwner,
            balance
        );

        emit EmergencyTokensWithdrawn(
            tokenOwner,
            tokenAddress,
            balance
        );
    }

    // =============================================================
    //                           OVERRIDES
    // =============================================================

    /// @dev
    /// Single token-balance movement gate used for emergency pause
    /// enforcement.
    ///
    /// OpenZeppelin ERC20 routes transfers, transferFrom operations,
    /// minting and burning through `_update`.
    ///
    /// Applying pause enforcement at this level therefore provides one
    /// consistent control point for every balance-changing MINE action.
    ///
    /// The fixed initial mint occurs only during construction and there
    /// is no application-level mint entry point after deployment.
    ///
    /// @param from Address whose balance decreases.
    /// @param to Address whose balance increases.
    /// @param value Amount of MINE moved.
    function _update(
        address from,
        address to,
        uint256 value
    )
        internal
        override
        whenNotPaused
    {
        super._update(
            from,
            to,
            value
        );
    }
}
