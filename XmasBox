pragma solidity 0.8.37;

import {IERC20} from "@openzeppelin/contracts@5.7.0/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts@5.7.0/token/ERC20/utils/SafeERC20.sol";
import {Ownable} from "@openzeppelin/contracts@5.7.0/access/Ownable.sol";
import {Ownable2Step} from "@openzeppelin/contracts@5.7.0/access/Ownable2Step.sol";
import {Pausable} from "@openzeppelin/contracts@5.7.0/utils/Pausable.sol";
import {ReentrancyGuardTransient} from "@openzeppelin/contracts@5.7.0/utils/ReentrancyGuardTransient.sol";
import {EIP712} from "@openzeppelin/contracts@5.7.0/utils/cryptography/EIP712.sol";
import {ECDSA} from "@openzeppelin/contracts@5.7.0/utils/cryptography/ECDSA.sol";
import {Time} from "@openzeppelin/contracts@5.7.0/utils/types/Time.sol";

/// @title 1M BLOCKS XmasBox
/// @author 1M BLOCKS
/// @notice Fixed-duration, project-authorized MINE distribution on BNB Chain.
/// @dev
/// The backend manages the three-box layout and authenticates participants.
/// This contract verifies authorized payouts, not the randomness or layout.
/// The immutable signer is trusted to approve the correct recipient and reward.
/// A compromised signer may authorize payouts up to the fixed allocation.
/// Each recipient may receive one reward per UTC day.
/// Transaction submission is permissionless; rewards always go to the signed recipient.
/// Claims use the fixed-size ERC-2098 representation of an EIP-712 signature.
/// The owner cannot change the token, signer, allocation or event period.
/// No proxy, minting or pre-expiration withdrawal path is implemented.
/// The reentrancy guard uses EIP-1153 transient storage and requires a
/// Cancun-compatible EVM, as supported by BNB Smart Chain.
contract XmasBox is
    EIP712,
    Ownable2Step,
    Pausable,
    ReentrancyGuardTransient
{
    using SafeERC20 for IERC20;

    // =============================================================
    //                           CONSTANTS
    // =============================================================

    /// @notice 2026-12-01 00:00:00 UTC, inclusive.
    uint48 private constant _EVENT_START =
        1_796_083_200;

    /// @notice 2026-12-26 00:00:00 UTC, exclusive.
    uint48 private constant _EVENT_END =
        1_798_243_200;

    /// @notice Smallest-unit multiplier for the designated 18-decimal MINE token.
    uint256 private constant _TOKEN_UNIT =
        1e18;

    /// @notice Minimum permitted reward in smallest token units.
    uint256 private constant _SMALL_REWARD =
        5 * _TOKEN_UNIT;

    /// @notice Intermediate permitted reward in smallest token units.
    uint256 private constant _MEDIUM_REWARD =
        10 * _TOKEN_UNIT;

    /// @notice Maximum permitted reward in smallest token units.
    uint256 private constant _LARGE_REWARD =
        20 * _TOKEN_UNIT;

    /// @notice EIP-712 type hash binding each payout to its authorized UTC day.
    bytes32 private constant _CLAIM_TYPEHASH =
        keccak256(
            "Claim(address recipient,uint256 amount,uint256 dayIndex,uint256 deadline)"
        );

    // =============================================================
    //                             ERRORS
    // =============================================================

    /// @notice Invalid token, signer or recipient address.
    error InvalidAddress();

    /// @notice Invalid fixed distribution allocation.
    /// @dev Rejects allocations below the largest reward or not divisible by the smallest reward.
    error InvalidAllocation();

    /// @notice The event is outside its fixed operating period.
    error EventNotActive();

    /// @notice The authorization deadline has passed.
    /// @dev Equality with the deadline is permitted, subject to the event period and signed day.
    error AuthorizationExpired();

    /// @notice The supplied signature does not recover the immutable signer.
    /// @dev Malformed signatures may instead revert with an OpenZeppelin ECDSA error.
    error InvalidAuthorization();

    /// @notice The recipient has already received a reward today.
    error AlreadyClaimedToday();

    /// @notice The reward is not one of the permitted MINE amounts.
    error InvalidRewardAmount();

    /// @notice The fixed lifetime distribution allocation is insufficient.
    /// @dev Unused allocation may exceed actual inventory; both constraints apply to successful claims.
    error AllocationExhausted();

    /// @notice Recovery is unavailable until the fixed event end.
    error EventStillActive();

    /// @notice No MINE remains to recover.
    error NoTokensToWithdraw();

    /// @notice Ownership renouncement is intentionally disabled.
    error OwnershipRenounceDisabled();

    // =============================================================
    //                            STORAGE
    // =============================================================

    /// @notice Immutable MINE token used for all payouts.
    /// @dev Fixed at deployment; code existence alone does not establish ERC20 compatibility.
    IERC20 public immutable mineToken;

    /// @notice Immutable project ECDSA authorization signer.
    /// @dev A compromised signer may authorize any permitted reward until the cap is exhausted or claims are paused.
    address public immutable authorizationSigner;

    /// @notice Fixed lifetime allocation, expressed in smallest token units.
    /// @dev A payout ceiling, not a funding guarantee; direct deposits do not increase this value.
    uint256 public immutable distributionCap;

    /// @notice Remaining lifetime allocation, independent of live token inventory.
    /// @dev Initialized to distributionCap and decreased only by successful claims.
    /// Cumulative distribution is derived from the immutable cap and this value.
    uint256 private _remainingAllocation;

    /// @notice Last successful UTC day index recorded for each recipient.
    /// @dev Zero denotes no successful claim; all event days are greater than zero.
    mapping(address recipient => uint256 dayIndex) private _lastClaimDay;

    // =============================================================
    //                             EVENTS
    // =============================================================

    /// @notice Emitted once with the immutable deployment configuration.
    /// @dev Records the configured allocation, not an actual deposit of MINE.
    /// @param token Designated MINE token contract.
    /// @param signer Project authorization signer.
    /// @param allocation Fixed lifetime distribution cap.
    event XmasBoxInitialized(
        address indexed token,
        address indexed signer,
        uint256 allocation
    );

    /// @notice Emitted after an authorized reward is transferred.
    /// @dev The recipient is the signed beneficiary, not necessarily the transaction sender.
    /// @param recipient Wallet receiving MINE.
    /// @param amount Amount transferred in smallest ERC20 units.
    /// @param dayIndex UTC day index of the completed claim.
    event TokensClaimed(
        address indexed recipient,
        uint256 amount,
        uint256 indexed dayIndex
    );

    /// @notice Emitted after post-expiration recovery.
    /// @dev Recovery does not consume the remaining allocation or alter historical claims.
    /// @param recipient Current owner receiving the remaining MINE.
    /// @param amount Amount recovered in smallest ERC20 units.
    event RemainingTokensWithdrawn(
        address indexed recipient,
        uint256 amount
    );

    // =============================================================
    //                          CONSTRUCTOR
    // =============================================================

    /// @notice Deploys the fixed-duration distribution contract.
    /// @dev Fixes the signer and lifetime allocation without depositing any tokens.
    /// @param mineTokenAddress Deployed MINE token address.
    /// @param signerAddress Project authorization signer address.
    /// @param allocation Fixed lifetime cap in smallest token units.
    constructor(
        address mineTokenAddress,
        address signerAddress,
        uint256 allocation
    )
        EIP712("1M BLOCKS XmasBox", "1")
        Ownable(msg.sender)
    {
        if (signerAddress == address(0)) {
            revert InvalidAddress();
        }

        if (mineTokenAddress == address(0)) {
            revert InvalidAddress();
        }

        if (mineTokenAddress.code.length == 0) {
            revert InvalidAddress();
        }

        if (allocation <= _LARGE_REWARD - 1) {
            revert InvalidAllocation();
        }

        if (allocation % _SMALL_REWARD != 0) {
            revert InvalidAllocation();
        }

        if (Time.timestamp() >= _EVENT_END) {
            revert EventNotActive();
        }

        mineToken =
            IERC20(mineTokenAddress);

        authorizationSigner =
            signerAddress;

        distributionCap =
            allocation;

        _remainingAllocation =
            allocation;

        emit XmasBoxInitialized(
            mineTokenAddress,
            signerAddress,
            allocation
        );
    }

    // =============================================================
    //                         CLAIM FUNCTION
    // =============================================================

    /// @notice Transfers one project-authorized daily reward.
    /// @dev
    /// The backend must authenticate the wallet and persist one final selection
    /// before issuing an authorization. The contract does not verify box layouts.
    /// EIP-712 binds the recipient, amount, UTC day, deadline, chain and contract.
    /// A copied authorization cannot redirect payment to another address.
    /// State is updated before token transfer and rolls back on transfer failure.
    /// Insufficient MINE inventory is rejected by the token transfer itself.
    /// The signed day index is derived from the current block timestamp;
    /// it is not supplied separately in calldata. A signature for any other
    /// day cannot validate against the current day.
    /// @param recipient Address receiving the reward.
    /// @param amount Reward in smallest token units.
    /// @param deadline Last valid authorization timestamp.
    /// @param r First 32-byte component of the project signer signature.
    /// @param vs ERC-2098 packed recovery parity and canonical s component.
    function claim(
        address recipient,
        uint256 amount,
        uint256 deadline,
        bytes32 r,
        bytes32 vs
    )
        external
        nonReentrant
        whenNotPaused
    {
        uint48 currentTimestamp =
            Time.timestamp();

        if (
            currentTimestamp < _EVENT_START ||
            currentTimestamp >= _EVENT_END
        ) {
            revert EventNotActive();
        }

        if (recipient == address(0)) {
            revert InvalidAddress();
        }

        if (currentTimestamp > deadline) {
            revert AuthorizationExpired();
        }

        if (
            amount != _SMALL_REWARD &&
            amount != _MEDIUM_REWARD &&
            amount != _LARGE_REWARD
        ) {
            revert InvalidRewardAmount();
        }

        uint256 dayIndex =
            currentTimestamp / 1 days;

        if (_lastClaimDay[recipient] == dayIndex) {
            revert AlreadyClaimedToday();
        }

        uint256 remaining =
            _remainingAllocation;

        if (amount > remaining) {
            revert AllocationExhausted();
        }

        _validateAuthorization(
            recipient,
            amount,
            dayIndex,
            deadline,
            r,
            vs
        );

        _lastClaimDay[recipient] =
            dayIndex;

        _remainingAllocation =
            remaining - amount;

        mineToken.safeTransfer(
            recipient,
            amount
        );

        emit TokensClaimed(
            recipient,
            amount,
            dayIndex
        );
    }

    // =============================================================
    //                       INTERNAL HELPERS
    // =============================================================

    /// @notice Validates the complete payout against the immutable signer.
    /// @dev OpenZeppelin recovers the signer directly from ERC-2098 components.
    /// Recovery enforces canonical low-s signatures and rejects invalid recovery.
    /// Replay protection is based on the recipient and UTC day, never signature bytes.
    /// @param recipient Authorized reward recipient.
    /// @param amount Authorized reward in smallest ERC20 units.
    /// @param dayIndex Authorized UTC day index.
    /// @param deadline Last valid authorization timestamp.
    /// @param r First 32-byte component of the project signer signature.
    /// @param vs ERC-2098 packed recovery parity and canonical s component.
    function _validateAuthorization(
        address recipient,
        uint256 amount,
        uint256 dayIndex,
        uint256 deadline,
        bytes32 r,
        bytes32 vs
    )
        private
        view
    {
        bytes32 structHash =
            keccak256(
                abi.encode(
                    _CLAIM_TYPEHASH,
                    recipient,
                    amount,
                    dayIndex,
                    deadline
                )
            );

        bytes32 digest =
            _hashTypedDataV4(structHash);

        if (
            ECDSA.recover(
                digest,
                r,
                vs
            ) != authorizationSigner
        ) {
            revert InvalidAuthorization();
        }
    }

    // =============================================================
    //                         VIEW FUNCTIONS
    // =============================================================

    /// @notice Indicates whether the recipient has received a reward today.
    /// @dev Does not evaluate event status, funding or backend eligibility.
    /// @param recipient Wallet address to inspect.
    /// @return claimed Whether the wallet has claimed today.
    function hasClaimedToday(
        address recipient
    )
        external
        view
        returns (
            bool claimed
        )
    {
        uint48 currentTimestamp =
            Time.timestamp();

        claimed =
            _lastClaimDay[recipient] ==
            currentTimestamp / 1 days;
    }

    /// @notice Returns cumulative MINE successfully distributed.
    /// @dev Derived from the immutable cap and remaining lifetime allocation.
    /// Direct funding and post-expiration withdrawals do not modify this value.
    /// @return distributed Total paid in smallest ERC20 units.
    function totalDistributed()
        external
        view
        returns (
            uint256 distributed
        )
    {
        distributed =
            distributionCap - _remainingAllocation;
    }

    /// @notice Returns the remaining lifetime allocation.
    /// @dev Reports the unused payout cap, not the current ERC20 balance.
    /// @return remaining Unused allocation in smallest ERC20 units.
    function getRemainingAllocation()
        external
        view
        returns (
            uint256 remaining
        )
    {
        remaining =
            _remainingAllocation;
    }

    // =============================================================
    //                             PAUSE
    // =============================================================

    /// @notice Blocks new claims during an emergency.
    /// @dev Only the owner may pause claims; the fixed event end is not extended.
    function pause()
        external
        onlyOwner
    {
        _pause();
    }

    /// @notice Restores claims subject to the original event conditions.
    /// @dev Resuming does not reset claim history, the allocation or the event period.
    function unpause()
        external
        onlyOwner
    {
        _unpause();
    }

    // =============================================================
    //                          OWNERSHIP
    // =============================================================

    /// @inheritdoc Ownable
    /// @notice Permanently rejects ownership renouncement.
    /// @dev Always reverts for the owner; two-step ownership transfers remain available.
    function renounceOwnership()
        public
        view
        override
        onlyOwner
    {
        revert OwnershipRenounceDisabled();
    }

    // =============================================================
    //                    POST-EXPIRATION RECOVERY
    // =============================================================

    /// @notice Returns remaining MINE to the current owner after expiration.
    /// @dev No withdrawal is permitted during the event, even while paused.
    /// Native BNB and unknown calls revert by default; no fallback is provided.
    function withdrawRemainingTokens()
        external
        nonReentrant
        onlyOwner
    {
        if (Time.timestamp() < _EVENT_END) {
            revert EventStillActive();
        }

        uint256 balance =
            mineToken.balanceOf(address(this));

        if (balance == 0) {
            revert NoTokensToWithdraw();
        }

        address recipient =
            _msgSender();

        mineToken.safeTransfer(
            recipient,
            balance
        );

        emit RemainingTokensWithdrawn(
            recipient,
            balance
        );
    }
}
