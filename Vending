pragma solidity 0.8.37;

import "@openzeppelin/contracts@5.7.0/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts@5.7.0/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts@5.7.0/access/Ownable2Step.sol";
import "@openzeppelin/contracts@5.7.0/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts@5.7.0/utils/Pausable.sol";

/// @title 1M BLOCKS MINE Vending
/// @author 1M BLOCKS
/// @notice Fixed-price MINE token vending service on BNB Chain.
/// @dev
/// Overview:
/// This contract sells existing MINE tokens for native BNB.
/// Buyers select one of four permanently fixed packages and receive
/// the corresponding MINE allocation immediately in the same transaction.
/// The contract does not mint tokens or calculate exchange rates dynamically.
///
/// Core design:
/// - one immutable MINE token reference;
/// - four permanently fixed purchase packages;
/// - exact native BNB payments;
/// - immediate delivery from available MINE inventory;
/// - no total sale allocation or fundraising hard cap;
/// - no whitelist, cooldown, or administrative wallet purchase limit;
/// - owner-managed inventory deposits and asset withdrawals;
/// - temporary suspension of purchases;
/// - irreversible closure of the vending service;
/// - cumulative purchase accounting and dedicated operational events.
///
/// Fixed purchase packages:
/// - Package 0: 0.02 BNB for 500 MINE;
/// - Package 1: 0.08 BNB for 2,000 MINE;
/// - Package 2: 0.2 BNB for 5,000 MINE plus 500 bonus MINE;
/// - Package 3: 1 BNB for 25,000 MINE plus 5,000 bonus MINE.
///
/// Security and operating properties:
/// - The designated MINE address is fixed during deployment.
/// - Package prices, quantities, and bonuses cannot be modified.
/// - Purchases require exact BNB payment and sufficient MINE inventory.
/// - Payment, accounting, and token delivery execute atomically.
/// - Failed MINE transfers revert the entire purchase transaction.
/// - Purchased MINE is transferred directly to the buyer.
/// - No minting, vesting, delayed claim, or refund mechanism exists.
/// - Managed inventory deposits require prior ERC20 approval.
/// - Direct MINE transfers may also increase available inventory.
/// - Direct transfers do not emit the dedicated deposit event.
/// - The owner may withdraw available MINE and BNB at any time.
/// - No minimum inventory or BNB reserve is enforced.
/// - Unrelated ERC20 assets may be recovered by the owner.
/// - MINE is excluded from unrelated ERC20 recovery.
/// - Temporary pausing prevents purchases without blocking asset management.
/// - Managed deposits remain available during temporary suspension.
/// - Permanent closure disables purchases and managed deposits forever.
/// - Permanent closure cannot be reversed by any subsequent owner.
/// - Asset withdrawals remain available after permanent closure.
/// - Historical accounting and event records remain accessible.
/// - Ownable2Step protects administrative ownership transfers.
/// - Ownership renouncement is permanently disabled.
/// - SafeERC20 handles all managed ERC20 transfers.
/// - ReentrancyGuard protects external asset-moving functions.
/// - Purchase accounting is updated before external token delivery.
/// - The underlying MINE token may independently pause transfers.
/// - A token-level pause may prevent deposits, purchases, and withdrawals.
/// - No proxy, upgrade mechanism, or adjustable sale configuration exists.
/// - Ordinary direct BNB transfers and unknown calls revert.
/// - Forced native BNB transfers cannot be universally prevented.
/// - Historical sale counters are independent of current asset balances.
/// - Closing does not destroy the contract or erase transaction history.
contract Vending is
    Ownable2Step,
    ReentrancyGuard,
    Pausable
{
    using SafeERC20 for IERC20;

    // =============================================================
    //                           CONSTANTS
    // =============================================================

    /// @notice Smallest-unit multiplier for MINE token quantities.
    /// @dev
    /// The designated MINE token uses 18 decimal places.
    /// Package allocations are expressed in the token's smallest ERC20 unit.
    /// This constant does not represent an exchange rate or adjustable price.
    uint256 private constant _TOKEN_UNIT = 1e18;

    // =============================================================
    //                             ERRORS
    // =============================================================

    /// @notice Reverts when the designated MINE token has no deployed code.
    /// @dev
    /// Used during construction before assigning the immutable token reference.
    /// Code existence alone does not establish ERC20 compatibility.
    error TokenNotDeployed();

    /// @notice Reverts when the selected purchase package does not exist.
    /// @dev
    /// Only package identifiers 0, 1, 2, and 3 are supported.
    /// No additional packages can be registered after deployment.
    ///
    /// @param packageId Unsupported package identifier.
    error InvalidPackage(
        uint8 packageId
    );

    /// @notice Reverts when the supplied BNB differs from the fixed package price.
    /// @dev
    /// Both insufficient and excess payments are rejected.
    /// Partial purchases and automatic change are not supported.
    ///
    /// @param provided Actual native BNB supplied in wei.
    /// @param required Required native BNB payment in wei.
    error IncorrectBNBAmount(
        uint256 provided,
        uint256 required
    );

    /// @notice Reverts when an operation is prohibited after permanent closure.
    /// @dev
    /// Permanent closure blocks purchases, managed deposits, reopening,
    /// and repeated closure attempts.
    /// Owner withdrawals and unrelated ERC20 recovery remain available.
    error VendingAlreadyClosed();

    /// @notice Reverts when a managed asset transfer specifies zero amount.
    /// @dev
    /// Zero-value inventory deposits, withdrawals, and unrelated
    /// ERC20 recovery operations are rejected.
    error ZeroAmount();

    /// @notice Reverts when available MINE inventory cannot cover a purchase.
    /// @dev
    /// Required inventory includes the complete base and bonus allocation.
    /// Inventory is measured using the live ERC20 balance.
    /// A rejected purchase does not retain the buyer's BNB payment.
    ///
    /// @param required Total MINE required in smallest ERC20 units.
    /// @param available Current MINE inventory in smallest ERC20 units.
    error InsufficientInventory(
        uint256 required,
        uint256 available
    );

    /// @notice Reverts when a requested withdrawal exceeds available assets.
    /// @dev
    /// Applies to native BNB, MINE, and unrelated ERC20 tokens.
    /// Amounts are expressed in the smallest units of the relevant asset.
    ///
    /// @param requested Requested withdrawal or recovery amount.
    /// @param available Current balance of the relevant asset.
    error InsufficientBalance(
        uint256 requested,
        uint256 available
    );

    /// @notice Reverts when an address argument is the zero address.
    /// @dev
    /// Used to reject an invalid unrelated ERC20 recovery target.
    error ZeroAddress();

    /// @notice Reverts when an address contains no deployed contract code.
    /// @dev
    /// Code-length validation does not guarantee ERC20 compatibility.
    /// An incompatible target may still revert during an external call.
    ///
    /// @param account Address that failed the code-length validation.
    error AddressIsNotContract(
        address account
    );

    /// @notice Reverts when MINE is selected for unrelated ERC20 recovery.
    /// @dev
    /// MINE inventory must be withdrawn through withdrawTokens().
    /// This keeps inventory withdrawal records separate from recovery records.
    error CannotRecoverMINE();

    /// @notice Reverts when a native BNB withdrawal transfer fails.
    /// @dev
    /// A failed native transfer reverts the complete withdrawal.
    /// No successful withdrawal event remains after the revert.
    error BNBTransferFailed();

    /// @notice Reverts when the owner attempts to renounce ownership.
    /// @dev
    /// Ownership remains necessary for inventory withdrawals,
    /// native BNB withdrawals, and recovery of unrelated ERC20 assets.
    error OwnershipRenounceDisabled();

    /// @notice Reverts on ordinary direct BNB transfers or unknown calls.
    /// @dev
    /// Valid purchases must explicitly invoke buy() with a package identifier.
    /// Forced native BNB transfers cannot be prevented universally.
    error DirectBNBTransferNotAllowed();

    // =============================================================
    //                            STORAGE
    // =============================================================

    /// @notice Immutable MINE token reference used for all token operations.
    /// @dev
    /// Assigned once during construction.
    /// Used for inventory queries, deposits, purchases, and withdrawals.
    /// No owner function can replace the designated token contract.
    IERC20 public immutable mineToken;

    /// @notice Whether the vending service has permanently closed.
    /// @dev
    /// Initially false and set to true only by closeVending().
    /// No function can restore the open state after permanent closure.
    /// Asset withdrawal authority remains available regardless of this value.
    bool public vendingClosed;

    /// @notice Cumulative BNB received from completed purchases.
    /// @dev
    /// Increased only by successful buy() transactions.
    /// Owner withdrawals do not decrease this historical counter.
    /// BNB received outside purchases is excluded from sale accounting.
    uint256 public totalBNBRaised;

    /// @notice Cumulative base MINE sold through completed purchases.
    /// @dev
    /// Excludes bonus MINE.
    /// Funding and inventory withdrawals do not modify this value.
    /// The value is cumulative rather than a current inventory balance.
    uint256 public totalTokensSold;

    /// @notice Cumulative bonus MINE distributed through purchases.
    /// @dev
    /// Increased only by successfully completed bonus-bearing purchases.
    /// Deposits and withdrawals do not change this historical amount.
    uint256 public totalBonusDistributed;

    /// @notice Number of successfully completed purchase transactions.
    /// @dev
    /// Increased once per successful buy() invocation.
    /// Reverted purchases cannot modify this counter.
    /// Multiple purchases by one address are counted separately.
    uint256 public totalPurchases;

    /// @notice Lifetime purchase accounting for an individual buyer.
    /// @dev
    /// The structure occupies two 256-bit storage slots.
    ///
    /// Storage layout:
    /// - contributedBNB occupies one complete uint256 slot;
    /// - receivedTokens and purchases share the second slot.
    ///
    /// contributedBNB records cumulative BNB payments in wei.
    /// receivedTokens records MINE delivered in smallest ERC20 units.
    /// purchases records the number of completed buy() transactions.
    ///
    /// All arithmetic is checked for overflow.
    /// Narrower fields have finite numerical ranges.
    /// These limits are not administrator-configurable purchase restrictions.
    struct BuyerInfo {
        uint256 contributedBNB;
        uint128 receivedTokens;
        uint128 purchases;
    }

    /// @notice Stores historical purchase accounting by buyer address.
    /// @dev
    /// Updated only through successful purchases.
    /// Historical records remain available after suspension and closure.
    /// Asset withdrawals do not modify buyer purchase history.
    mapping(address => BuyerInfo) private _buyerInfo;

    // =============================================================
    //                             EVENTS
    // =============================================================

    /// @notice Emitted when a buyer successfully purchases and receives MINE.
    /// @dev
    /// Each completed purchase emits exactly one event.
    /// Base and bonus quantities are recorded separately.
    /// A failed transfer reverts the transaction and prevents event retention.
    ///
    /// @param buyer Address that paid BNB and received MINE.
    /// @param packageId Selected fixed purchase package.
    /// @param bnbPaid Native BNB received in wei.
    /// @param baseAmount Base MINE delivered in smallest ERC20 units.
    /// @param bonusAmount Bonus MINE delivered in smallest ERC20 units.
    /// @param totalAmount Combined MINE delivered in smallest ERC20 units.
    event TokensPurchased(
        address indexed buyer,
        uint8 indexed packageId,
        uint256 bnbPaid,
        uint256 baseAmount,
        uint256 bonusAmount,
        uint256 totalAmount
    );

    /// @notice Emitted after a successful managed MINE inventory deposit.
    /// @dev
    /// Only depositTokens() emits this event.
    /// Direct ERC20 transfers do not trigger the dedicated deposit event.
    /// A failed transferFrom cannot produce a committed deposit record.
    ///
    /// @param depositor Owner address supplying MINE inventory.
    /// @param amount MINE deposited in smallest ERC20 units.
    event TokensDeposited(
        address indexed depositor,
        uint256 amount
    );

    /// @notice Emitted after a successful owner withdrawal of MINE.
    /// @dev
    /// Records a managed inventory withdrawal.
    /// Historical purchase accounting remains unchanged.
    ///
    /// @param recipient Owner address receiving MINE.
    /// @param amount MINE withdrawn in smallest ERC20 units.
    event TokensWithdrawn(
        address indexed recipient,
        uint256 amount
    );

    /// @notice Emitted after a successful native BNB withdrawal.
    /// @dev
    /// Records the BNB amount transferred to the owner.
    /// Historical BNB sales remain unchanged after withdrawal.
    ///
    /// @param recipient Owner address receiving native BNB.
    /// @param amount Native BNB withdrawn in wei.
    event BNBWithdrawn(
        address indexed recipient,
        uint256 amount
    );

    /// @notice Emitted after recovering an unrelated ERC20 asset.
    /// @dev
    /// The designated MINE token cannot be recovered through this path.
    /// Recovery does not affect MINE purchase accounting.
    ///
    /// @param token Address of the recovered ERC20 contract.
    /// @param recipient Owner address receiving the recovered asset.
    /// @param amount Recovered amount in the asset's smallest units.
    event ERC20Recovered(
        address indexed token,
        address indexed recipient,
        uint256 amount
    );

    /// @notice Emitted exactly once upon irreversible vending closure.
    /// @dev
    /// Captures cumulative sale statistics at the moment of closure.
    /// Subsequent withdrawals do not change the recorded sale history.
    /// Closure does not transfer assets or destroy the contract.
    ///
    /// @param closedBy Owner address initiating permanent closure.
    /// @param closedAt Block timestamp of permanent closure.
    /// @param bnbRaised Cumulative BNB collected through purchases.
    /// @param tokensDistributed Total base and bonus MINE delivered.
    /// @param purchases Number of completed purchase transactions.
    event VendingClosed(
        address indexed closedBy,
        uint256 closedAt,
        uint256 bnbRaised,
        uint256 tokensDistributed,
        uint256 purchases
    );

    // =============================================================
    //                          CONSTRUCTOR
    // =============================================================

    /// @notice Deploys the fixed-price MINE vending contract.
    /// @dev
    /// Deployment requirements:
    /// - the designated MINE address must contain deployed contract code.
    ///
    /// Post-deployment state:
    /// - the deployer becomes the initial owner;
    /// - the token reference is assigned permanently;
    /// - vendingClosed is false;
    /// - purchases are initially unpaused;
    /// - cumulative accounting counters are initialized to zero;
    /// - no token inventory is deposited automatically.
    ///
    /// Token compatibility:
    /// The designated token is expected to use 18 decimals and
    /// standard ERC20 transfers without a transfer tax.
    /// Code existence alone does not verify these properties.
    constructor()
        Ownable(msg.sender)
    {
        address tokenAddress =
            0x20aF460A151ce67Dbe2bc095A6cEf2932fF7FCef;

        if (tokenAddress.code.length == 0) {
            revert TokenNotDeployed();
        }

        mineToken =
            IERC20(tokenAddress);
    }

    // =============================================================
    //                       PURCHASE FUNCTION
    // =============================================================

    /// @notice Purchases one fixed MINE package using native BNB.
    /// @dev
    /// Purchase requirements:
    /// - the vending service must not be permanently closed;
    /// - purchases must not be temporarily paused;
    /// - the selected package identifier must be valid;
    /// - msg.value must match the exact package price;
    /// - available MINE inventory must cover base and bonus tokens.
    ///
    /// Purchase behavior:
    /// - the package identifier determines the fixed payment and payout;
    /// - exact BNB payment and live MINE inventory are validated;
    /// - buyer and global cumulative records are updated;
    /// - the complete MINE allocation is transferred to msg.sender;
    /// - TokensPurchased is emitted after successful token delivery.
    ///
    /// Atomicity:
    /// - invalid packages or incorrect payments revert;
    /// - insufficient inventory prevents purchase completion;
    /// - token transfer failure reverts all accounting changes;
    /// - failed purchases do not retain the buyer's BNB;
    /// - no partially completed purchase remains committed.
    ///
    /// Limitations:
    /// - arbitrary purchase quantities are not supported;
    /// - purchasers cannot select an alternative token recipient;
    /// - no administrative wallet purchase cap is enforced;
    /// - finite integer ranges remain subject to overflow checks;
    /// - MINE token-level pausing may prevent delivery.
    ///
    /// @param packageId Fixed package identifier from 0 through 3.
    function buy(
        uint8 packageId
    )
        external
        payable
        nonReentrant
        whenNotPaused
    {
        if (vendingClosed) {
            revert VendingAlreadyClosed();
        }

        (
            uint256 bnbPrice,
            uint256 baseAmount,
            uint256 bonusAmount
        ) = _getPackage(packageId);

        if (msg.value != bnbPrice) {
            revert IncorrectBNBAmount(
                msg.value,
                bnbPrice
            );
        }

        uint256 totalAmount =
            baseAmount + bonusAmount;

        uint256 available =
            mineToken.balanceOf(address(this));

        if (available < totalAmount) {
            revert InsufficientInventory(
                totalAmount,
                available
            );
        }

        BuyerInfo storage buyer =
            _buyerInfo[msg.sender];

        buyer.contributedBNB +=
            msg.value;

        buyer.receivedTokens +=
            uint128(totalAmount);

        ++buyer.purchases;

        totalBNBRaised +=
            msg.value;

        totalTokensSold +=
            baseAmount;

        totalBonusDistributed +=
            bonusAmount;

        ++totalPurchases;

        mineToken.safeTransfer(
            msg.sender,
            totalAmount
        );

        emit TokensPurchased(
            msg.sender,
            packageId,
            msg.value,
            baseAmount,
            bonusAmount,
            totalAmount
        );
    }

    // =============================================================
    //                        FUNDING FUNCTION
    // =============================================================

    /// @notice Deposits MINE inventory from the current owner.
    /// @dev
    /// Funding requirements:
    /// - the caller must be the current owner;
    /// - vending must not be permanently closed;
    /// - the requested deposit amount must be non-zero;
    /// - sufficient allowance and transferable MINE must exist.
    ///
    /// Funding behavior:
    /// - the owner approves vending through the MINE token contract;
    /// - SafeERC20 transfers MINE into vending custody;
    /// - successful managed funding emits TokensDeposited;
    /// - no cumulative funding target or inventory cap is enforced.
    ///
    /// Important limitations:
    /// - deposits remain available while purchasing is paused;
    /// - managed deposits become unavailable after permanent closure;
    /// - direct ERC20 transfers may still increase inventory;
    /// - direct transfers do not emit TokensDeposited;
    /// - MINE token-level pausing may prevent funding.
    ///
    /// @param amount MINE quantity in smallest ERC20 units.
    function depositTokens(
        uint256 amount
    )
        external
        onlyOwner
        nonReentrant
    {
        if (vendingClosed) {
            revert VendingAlreadyClosed();
        }

        if (amount == 0) {
            revert ZeroAmount();
        }

        mineToken.safeTransferFrom(
            msg.sender,
            address(this),
            amount
        );

        emit TokensDeposited(
            msg.sender,
            amount
        );
    }

    // =============================================================
    //                         VIEW FUNCTIONS
    // =============================================================

    /// @notice Returns the fixed purchase terms of a package.
    /// @dev
    /// Package values are encoded directly in the contract logic.
    /// The function does not check current inventory or operating status.
    /// Unsupported identifiers revert without returning package terms.
    ///
    /// @param packageId Package identifier from 0 through 3.
    /// @return bnbPrice Required native BNB payment in wei.
    /// @return baseAmount Base MINE in smallest ERC20 units.
    /// @return bonusAmount Bonus MINE in smallest ERC20 units.
    /// @return totalAmount Combined MINE in smallest ERC20 units.
    function getPackage(
        uint8 packageId
    )
        external
        pure
        returns (
            uint256 bnbPrice,
            uint256 baseAmount,
            uint256 bonusAmount,
            uint256 totalAmount
        )
    {
        (
            bnbPrice,
            baseAmount,
            bonusAmount
        ) = _getPackage(packageId);

        totalAmount =
            baseAmount + bonusAmount;
    }

    /// @notice Returns cumulative base and bonus MINE distributed.
    /// @dev
    /// The total is derived from existing historical purchase counters.
    /// No separate storage slot is used for this combined quantity.
    /// Inventory funding and withdrawals do not modify the result.
    ///
    /// @return distributed Total MINE delivered in smallest ERC20 units.
    function totalTokensDistributed()
        external
        view
        returns (
            uint256 distributed
        )
    {
        return
            totalTokensSold +
            totalBonusDistributed;
    }

    /// @notice Returns the current MINE inventory held by vending.
    /// @dev
    /// Uses the live ERC20 balance at the vending contract address.
    /// Includes managed deposits and ordinary direct token transfers.
    /// Inventory may be reduced through subsequent owner withdrawals.
    /// This view does not reserve inventory for pending purchases.
    ///
    /// @return inventory Available MINE in smallest ERC20 units.
    function getInventory()
        external
        view
        returns (
            uint256 inventory
        )
    {
        return
            mineToken.balanceOf(
                address(this)
            );
    }

    /// @notice Returns cumulative purchase accounting for one buyer.
    /// @dev
    /// Only completed buy() transactions update this record.
    /// An address without purchases returns zero-valued fields.
    /// Historical information remains accessible after closure.
    ///
    /// @param buyer Wallet address whose purchase history is requested.
    /// @return info Cumulative BNB, received MINE, and purchase count.
    function getBuyerInfo(
        address buyer
    )
        external
        view
        returns (
            BuyerInfo memory info
        )
    {
        return
            _buyerInfo[buyer];
    }

    /// @notice Returns the current native BNB balance of vending.
    /// @dev
    /// The balance includes unwithdrawn purchase proceeds.
    /// It may also include native BNB received through forced transfers.
    /// It is not necessarily equal to cumulative sales minus withdrawals.
    ///
    /// @return balance Current native BNB balance in wei.
    function getBNBBalance()
        external
        view
        returns (
            uint256 balance
        )
    {
        return
            address(this).balance;
    }

    // =============================================================
    //                         ADMIN FUNCTIONS
    // =============================================================

    /// @notice Temporarily suspends new MINE purchases.
    /// @dev
    /// Only the current owner may pause vending.
    /// The inherited Pausable implementation emits Paused.
    /// Funding, withdrawals, recovery, and closure remain available.
    /// This operation does not pause the underlying MINE token.
    function pause()
        external
        onlyOwner
    {
        _pause();
    }

    /// @notice Resumes purchasing after temporary suspension.
    /// @dev
    /// Only the current owner may resume purchases.
    /// Permanently closed vending cannot be reopened.
    /// The inherited Pausable implementation emits Unpaused.
    /// A separate MINE token pause may still prevent token delivery.
    function unpause()
        external
        onlyOwner
    {
        if (vendingClosed) {
            revert VendingAlreadyClosed();
        }

        _unpause();
    }

    /// @notice Withdraws available MINE inventory to the current owner.
    /// @dev
    /// Withdrawal requirements:
    /// - the caller must be the current owner;
    /// - the amount must be greater than zero;
    /// - actual MINE inventory must cover the requested amount.
    ///
    /// Withdrawal behavior:
    /// - SafeERC20 transfers MINE directly to the current owner;
    /// - successful withdrawals emit TokensWithdrawn;
    /// - failed transfers revert the complete operation;
    /// - historical purchase accounting remains unchanged.
    ///
    /// Important limitations:
    /// - withdrawals remain available while paused or permanently closed;
    /// - previously purchased tokens cannot be reclaimed from buyers;
    /// - MINE token-level pausing may prevent withdrawals.
    ///
    /// @param amount MINE quantity in smallest ERC20 units.
    function withdrawTokens(
        uint256 amount
    )
        external
        onlyOwner
        nonReentrant
    {
        if (amount == 0) {
            revert ZeroAmount();
        }

        uint256 available =
            mineToken.balanceOf(address(this));

        if (amount > available) {
            revert InsufficientBalance(
                amount,
                available
            );
        }

        address recipient =
            owner();

        mineToken.safeTransfer(
            recipient,
            amount
        );

        emit TokensWithdrawn(
            recipient,
            amount
        );
    }

    /// @notice Withdraws native BNB to the current owner.
    /// @dev
    /// Withdrawal requirements:
    /// - the caller must be the current owner;
    /// - the requested amount must be non-zero;
    /// - sufficient native BNB must be available.
    ///
    /// Withdrawal behavior:
    /// - a checked native call transfers BNB to the current owner;
    /// - ReentrancyGuard protects the external transfer path;
    /// - failed transfers revert the complete withdrawal;
    /// - successful transfers emit BNBWithdrawn;
    /// - historical BNB sales remain unchanged.
    ///
    /// Important limitations:
    /// - no sale closure or minimum BNB reserve is required;
    /// - withdrawals remain available after permanent closure;
    /// - a contract-based owner must be able to receive native BNB.
    ///
    /// @param amount Native BNB to withdraw in wei.
    function withdrawBNB(
        uint256 amount
    )
        external
        onlyOwner
        nonReentrant
    {
        if (amount == 0) {
            revert ZeroAmount();
        }

        uint256 available =
            address(this).balance;

        if (amount > available) {
            revert InsufficientBalance(
                amount,
                available
            );
        }

        address recipient =
            owner();

        (bool success, ) =
            payable(recipient).call{
                value: amount
            }("");

        if (!success) {
            revert BNBTransferFailed();
        }

        emit BNBWithdrawn(
            recipient,
            amount
        );
    }

    /// @notice Recovers an unrelated ERC20 asset held by vending.
    /// @dev
    /// Recovery requirements:
    /// - the caller must be the current owner;
    /// - the recovery target must be non-zero and contain deployed code;
    /// - the designated MINE token must not be selected;
    /// - the requested amount must be non-zero;
    /// - the contract must hold sufficient recoverable tokens.
    ///
    /// Recovery behavior:
    /// - SafeERC20 transfers the selected asset to the current owner;
    /// - a successful recovery emits ERC20Recovered;
    /// - failed transfers revert the complete operation;
    /// - historical MINE purchase accounting remains unchanged.
    ///
    /// Important limitations:
    /// - unrelated ERC20 recovery remains available after closure;
    /// - this function cannot access arbitrary third-party wallets;
    /// - deployed code does not guarantee ERC20 compatibility.
    ///
    /// @param token Address of the unrelated ERC20 contract.
    /// @param amount Recovery quantity in the token's smallest units.
    function recoverERC20(
        address token,
        uint256 amount
    )
        external
        onlyOwner
        nonReentrant
    {
        if (token == address(0)) {
            revert ZeroAddress();
        }

        if (token == address(mineToken)) {
            revert CannotRecoverMINE();
        }

        if (token.code.length == 0) {
            revert AddressIsNotContract(
                token
            );
        }

        if (amount == 0) {
            revert ZeroAmount();
        }

        IERC20 recoveryToken =
            IERC20(token);

        uint256 available =
            recoveryToken.balanceOf(address(this));

        if (amount > available) {
            revert InsufficientBalance(
                amount,
                available
            );
        }

        address recipient =
            owner();

        recoveryToken.safeTransfer(
            recipient,
            amount
        );

        emit ERC20Recovered(
            token,
            recipient,
            amount
        );
    }

    // =============================================================
    //                       PERMANENT CLOSURE
    // =============================================================

    /// @notice Irreversibly closes the vending service.
    /// @dev
    /// Closure requirements:
    /// - only the current owner may initiate permanent closure;
    /// - vending must not already be permanently closed.
    ///
    /// Closure behavior:
    /// - vendingClosed is permanently set to true;
    /// - subsequent purchases become unavailable;
    /// - future managed deposits become unavailable;
    /// - unpause() cannot reopen the vending service;
    /// - VendingClosed records cumulative completed sales;
    /// - no MINE or native BNB is transferred during closure.
    ///
    /// Post-closure behavior:
    /// - historical purchase accounting remains accessible;
    /// - the owner may withdraw remaining MINE and BNB;
    /// - unrelated ERC20 recovery remains available;
    /// - controlled ownership transfers remain possible;
    /// - direct ERC20 transfers may still reach this address;
    /// - previous transaction and event records remain on-chain.
    ///
    /// Permanent closure can complete successfully only once.
    /// No subsequent owner can reverse the closed state.
    function closeVending()
        external
        onlyOwner
    {
        if (vendingClosed) {
            revert VendingAlreadyClosed();
        }

        vendingClosed =
            true;

        emit VendingClosed(
            msg.sender,
            block.timestamp,
            totalBNBRaised,
            totalTokensSold + totalBonusDistributed,
            totalPurchases
        );
    }

    // =============================================================
    //                           OWNERSHIP
    // =============================================================

    /// @notice Permanently disables ownership renouncement.
    /// @dev
    /// Controlled ownership transfers remain possible through Ownable2Step.
    /// Renouncement is prohibited to preserve asset withdrawal authority.
    /// Ownership changes cannot alter fixed package conditions.
    /// Permanent closure cannot be reversed by a subsequent owner.
    ///
    /// This function always reverts for an authorized owner.
    function renounceOwnership()
        public
        view
        override
        onlyOwner
    {
        revert OwnershipRenounceDisabled();
    }

    // =============================================================
    //                       INTERNAL HELPERS
    // =============================================================

    /// @notice Resolves the permanently fixed terms of a purchase package.
    /// @dev
    /// All prices and token allocations are encoded directly in contract code.
    /// No administrative function or mutable storage can change these values.
    ///
    /// Package allocation:
    /// - 0: 0.02 BNB for 500 MINE;
    /// - 1: 0.08 BNB for 2,000 MINE;
    /// - 2: 0.2 BNB for 5,000 base and 500 bonus MINE;
    /// - 3: 1 BNB for 25,000 base and 5,000 bonus MINE.
    ///
    /// Invalid package identifiers revert without returning package terms.
    ///
    /// @param packageId Fixed package identifier from 0 through 3.
    /// @return bnbPrice Required native BNB in wei.
    /// @return baseAmount Base MINE in smallest ERC20 units.
    /// @return bonusAmount Bonus MINE in smallest ERC20 units.
    function _getPackage(
        uint8 packageId
    )
        internal
        pure
        returns (
            uint256 bnbPrice,
            uint256 baseAmount,
            uint256 bonusAmount
        )
    {
        if (packageId == 0) {
            return (
                0.02 ether,
                500 * _TOKEN_UNIT,
                0
            );
        }

        if (packageId == 1) {
            return (
                0.08 ether,
                2_000 * _TOKEN_UNIT,
                0
            );
        }

        if (packageId == 2) {
            return (
                0.2 ether,
                5_000 * _TOKEN_UNIT,
                500 * _TOKEN_UNIT
            );
        }

        if (packageId == 3) {
            return (
                1 ether,
                25_000 * _TOKEN_UNIT,
                5_000 * _TOKEN_UNIT
            );
        }

        revert InvalidPackage(
            packageId
        );
    }

    // =============================================================
    //                       RECEIVE / FALLBACK
    // =============================================================

    /// @notice Rejects ordinary direct native BNB transfers.
    /// @dev
    /// Purchases must explicitly invoke buy() with a package identifier.
    /// Forced native BNB transfers cannot be prevented universally.
    receive()
        external
        payable
    {
        revert DirectBNBTransferNotAllowed();
    }

    /// @notice Rejects unknown calls and unsupported native BNB transfers.
    /// @dev
    /// Unsupported function selectors are not treated as purchases.
    /// No fallback-based purchasing mechanism is implemented.
    fallback()
        external
        payable
    {
        revert DirectBNBTransferNotAllowed();
    }
}
