pragma solidity 0.8.37;

import "@openzeppelin/contracts@5.7.0/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts@5.7.0/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts@5.7.0/access/Ownable2Step.sol";
import "@openzeppelin/contracts@5.7.0/utils/ReentrancyGuard.sol";

/// @title 1M BLOCKS Staking Rewards Interface
/// @author 1M BLOCKS
/// @notice Minimal interface required for an external staking reward accounting service.
/// @dev
/// A registered service contract is responsible for calculating how much reward
/// a participant may claim at a given moment.
/// This vault does not calculate APR, staking duration, tier, multiplier, or
/// participant-level accruals on its own.
/// Instead, the vault calls the registered service, receives the amount owed,
/// and transfers MINE in the same transaction.
///
/// Integration expectations for the service implementation:
/// - it should restrict callers so that only the authorized RewardVault may call it;
/// - it should return the claimable reward for the supplied participant;
/// - it should consume or mark the claimed reward so it cannot be claimed twice;
/// - it should rely on the surrounding transaction for atomic rollback if the
///   vault payment later fails.
///
/// The reward accounting service must not send the reward token independently.
/// Only the vault is expected to hold reward liquidity and perform the ERC20 transfer.
/// The vault trusts the returned amount without independently recalculating it.
/// Service implementations must enforce their own participant reward eligibility.
/// Principal deposits and withdrawals remain outside this accounting interface.
interface IStakingRewards {
    /// @notice Consumes the currently claimable reward for one participant.
    /// @dev
    /// This function is intended to be called by the RewardVault only.
    /// The returned amount must use the reward token's smallest ERC20 unit.
    /// If the vault later reverts during token transfer, the EVM transaction
    /// reverts as a whole and the accounting side effects are rolled back too.
    /// The returned reward is interpreted as a quantity, not a payment instruction.
    ///
    /// @param staker Staking participant whose reward is being claimed.
    /// @return claimed Amount of MINE owed to the participant.
    function consumeClaim(
        address staker
    )
        external
        returns (
            uint256 claimed
        );
}

/// @title 1M BLOCKS Reward Vault
/// @author 1M BLOCKS
/// @notice Dedicated MINE reward vault for staking services on BNB Chain.
/// @dev
/// Overview:
/// This contract is a custody vault for reward liquidity only.
/// It is designed to hold MINE tokens and pay them out according to calculations
/// performed by up to two permanently registered external staking service contracts.
///
/// Core design:
/// - one immutable reward token;
/// - two maximum permanent service slots;
/// - no arbitrary owner withdrawal;
/// - no service removal or replacement once registered;
/// - no emergency pause or upgrade path inside the vault;
/// - reward accounting delegated to external service contracts;
/// - reward token transfer executed only by this vault.
///
/// Security and operating properties:
/// - The designated MINE token address is immutable after deployment.
/// - The intended initial reward allocation may be 100,000,000 MINE, but the vault
///   does not enforce that amount on-chain.
/// - Funding and payouts have no on-chain per-service or per-claim cap.
/// - Reward calculations are performed exclusively by registered staking contracts.
/// - A maximum of two distinct staking contracts can be registered in total.
/// - The current owner may fill an available slot, but cannot change a filled slot.
/// - Registered contract addresses cannot be removed, paused, or replaced.
/// - Both registered contracts may independently serve reward claims.
/// - Every participant may claim only their own rewards through claim().
/// - A claim always transfers MINE only to the participant who initiated it.
/// - Each staking contract must make its consumeClaim() callable only by this vault.
/// - Rewards accounting and MINE payment execute atomically in one transaction.
/// - If any MINE transfer fails, the complete transaction reverts, including accounting.
/// - SafeERC20 is used for every MINE transfer performed by this vault.
/// - ReentrancyGuard protects every external token-moving entry point.
/// - The owner has no arbitrary MINE withdrawal, recovery, sweep, or rescue function.
/// - No mining, expired-reward, project-reward, or liquidity payout path exists.
/// - No emergency pause, unregistration, proxy, or upgrade mechanism exists here.
/// - The owner may still register an untrusted contract while a slot is vacant.
/// - A malicious registered service can fabricate claims and deplete the vault.
/// - This vault does not independently authenticate a service's reward calculations.
/// - The vault does not track reward liabilities owed by either service.
/// - No receive or fallback function is implemented.
/// - Native BNB transfers and unknown calls revert by default.
/// - The two registered services share one MINE balance without per-service reserves.
/// - Service contracts retain responsibility for preventing duplicate reward accounting.
/// - Permanent registration fixes the address, not necessarily the service logic,
///   especially if the registered address is itself upgradeable.
/// - Closing a registered staking service does not release its permanent vault slot.
/// - No staking principal, APR, or user position data is stored in this vault.
/// - Shared liquidity is not reserved by service, account, or claim priority.
/// - No service can replace another service's registered slot or payout destination.
contract RewardVault is
    Ownable2Step,
    ReentrancyGuard
{
    using SafeERC20 for IERC20;

    // =============================================================
    //                           CONSTANTS
    // =============================================================

    /// @notice Maximum number of staking reward contracts that may ever be registered.
    /// @dev The vault supports exactly two lifetime append-only service slots.
    uint256 private constant _MAX_REWARDS_CONTRACTS =
        2;

    // =============================================================
    //                             ERRORS
    // =============================================================

    /// @notice Reverts when a required address argument is the zero address.
    /// @dev Used for token and service address validation.
    error ZeroAddress();

    /// @notice Reverts when an address has no deployed bytecode.
    /// @dev
    /// This check confirms the address is currently a contract,
    /// but it does not prove interface compliance or benign logic.
    ///
    /// @param account Address that failed the code-size validation.
    error AddressIsNotContract(
        address account
    );

    /// @notice Reverts when all permanent registration slots are already filled.
    /// @dev Once two services are registered, no further registrations are possible.
    error RewardsSlotsFull();

    /// @notice Reverts when attempting to register a previously registered service.
    /// @dev Duplicate registration is prevented across the two lifetime slots.
    error DuplicateRewardsContract();

    /// @notice Reverts when a requested slot is not currently registered.
    /// @dev Applies to both claims and service address reads.
    /// Unregistered slots cannot initiate an external reward accounting call.
    error InvalidRewardsSlot();

    /// @notice Reverts when reward funding is attempted with amount zero.
    /// @dev Zero-value funding is treated as invalid input.
    error ZeroFundingAmount();

    /// @notice Reverts when the owner attempts to renounce ownership.
    /// @dev
    /// Ownership renouncement is disabled so that any still-empty slot can
    /// continue to be filled later if needed.
    error OwnershipRenounceDisabled();

    // =============================================================
    //                            STORAGE
    // =============================================================

    /// @notice Immutable MINE token used for all reward funding and payouts.
    /// @dev
    /// This vault assumes the token behaves as an ERC20 compatible asset.
    /// The address is fixed forever at deployment.
    IERC20 public immutable mineToken;

    /// @notice Number of permanently occupied staking reward service slots.
    /// @dev
    /// Valid values are 0, 1, or 2 only.
    /// This count also determines which slot index will be filled next.
    uint256 public registeredRewardsCount;

    /// @notice Total amount of MINE successfully distributed by this vault.
    /// @dev
    /// This value increases only when a non-zero claim completes and the token
    /// transfer succeeds.
    /// It is cumulative and is never decremented.
    /// Failed reward transfers cannot increase this cumulative amount.
    /// Funding operations do not increase this counter.
    uint256 public totalDistributed;

    /// @notice Two permanent append-only slots for staking reward services.
    /// @dev
    /// Index 0 is filled first, index 1 second.
    /// An unregistered slot remains unset and cannot be used for claims.
    /// A service address remains recorded even if that service later stops operating.
    IStakingRewards[2] private _rewardsContracts;

    // =============================================================
    //                             EVENTS
    // =============================================================

    /// @notice Emitted once when a staking reward service is permanently registered.
    /// @dev
    /// Each slot may emit this event at most one time during the vault's lifetime.
    ///
    /// @param slot Index of the slot that was just filled.
    /// @param rewardsContract Address of the newly registered staking service.
    event RewardsContractRegistered(
        uint256 indexed slot,
        address indexed rewardsContract
    );

    /// @notice Emitted when MINE is deposited through fundRewards().
    /// @dev
    /// Direct ERC20 transfers to the vault do not emit this event because they do
    /// not call fundRewards().
    ///
    /// @param funder Address supplying the reward liquidity.
    /// @param amount Amount of MINE transferred into the vault.
    event RewardsFunded(
        address indexed funder,
        uint256 amount
    );

    /// @notice Emitted when a participant successfully receives staking rewards.
    /// @dev
    /// This event is emitted only after the service accounting call has succeeded
    /// and the corresponding MINE transfer has also succeeded.
    /// A payout is attributed to the service slot selected by the claimant.
    ///
    /// @param slot Registered service slot that accounted for the payout.
    /// @param staker Participant who received the reward tokens.
    /// @param claimed Amount of MINE transferred.
    event StakingRewardPaid(
        uint256 indexed slot,
        address indexed staker,
        uint256 claimed
    );

    // =============================================================
    //                          CONSTRUCTOR
    // =============================================================

    /// @notice Deploys the reward vault with two initially empty service slots.
    /// @dev
    /// Deployment requirements:
    /// - the token address must be non-zero;
    /// - the token address must currently contain deployed code.
    ///
    /// Post-deployment state:
    /// - `mineToken` becomes immutable;
    /// - the deployer becomes the initial owner through Ownable2Step/Ownable;
    /// - no service is registered automatically;
    /// - no reward liquidity is deposited automatically.
    ///
    /// This contract never takes custody of staking principal.
    /// It is intended for reward custody and payout only.
    ///
    /// @param mineTokenAddress Deployed MINE ERC20 token contract address.
    constructor(
        address mineTokenAddress
    )
        Ownable(msg.sender)
    {
        if (mineTokenAddress == address(0)) {
            revert ZeroAddress();
        }

        if (mineTokenAddress.code.length == 0) {
            revert AddressIsNotContract(
                mineTokenAddress
            );
        }

        mineToken =
            IERC20(mineTokenAddress);
    }

    // =============================================================
    //                     CONTRACT REGISTRATION
    // =============================================================

    /// @notice Permanently registers one additional staking reward service.
    /// @dev
    /// Registration behavior:
    /// - only the current owner may call this function;
    /// - slots are filled sequentially;
    /// - slot 0 is filled first, slot 1 second;
    /// - an occupied slot can never be cleared or overwritten;
    /// - the same service address cannot be registered twice.
    ///
    /// Important limitations:
    /// - this contract checks only that the target has deployed code;
    /// - it does not validate interface compliance at registration time;
    /// - it does not verify reward logic correctness;
    /// - it does not reserve separate liquidity per service;
    /// - it cannot later revoke the registered service's authority.
    ///
    /// Operational caution:
    /// Registering a proxy or upgradeable service does not guarantee that the
    /// service logic remains unchanged over time.
    /// Failed registration transactions never consume a permanent slot.
    /// Registration itself never transfers MINE from the vault to a service.
    /// The permanent authorization is exercised only through participant claims.
    ///
    /// @param rewardsContract Address of the staking reward accounting contract.
    function registerRewardsContract(
        address rewardsContract
    )
        external
        onlyOwner
    {
        uint256 slot =
            registeredRewardsCount;

        if (slot >= _MAX_REWARDS_CONTRACTS) {
            revert RewardsSlotsFull();
        }

        if (rewardsContract == address(0)) {
            revert ZeroAddress();
        }

        if (rewardsContract.code.length == 0) {
            revert AddressIsNotContract(
                rewardsContract
            );
        }

        if (
            slot != 0 &&
            rewardsContract == address(_rewardsContracts[0])
        ) {
            revert DuplicateRewardsContract();
        }

        _rewardsContracts[slot] =
            IStakingRewards(rewardsContract);

        registeredRewardsCount =
            slot + 1;

        emit RewardsContractRegistered(
            slot,
            rewardsContract
        );
    }

    // =============================================================
    //                       FUNDING FUNCTION
    // =============================================================

    /// @notice Deposits MINE into the vault to support future reward claims.
    /// @dev
    /// Funding behavior:
    /// - anyone may fund the vault;
    /// - owner privileges are not required;
    /// - the caller must approve this vault beforehand;
    /// - zero-amount funding is rejected;
    /// - SafeERC20 is used for the transferFrom call.
    ///
    /// Additional notes:
    /// - direct ERC20 transfers also increase available liquidity;
    /// - there is no enforced target or maximum reserve;
    /// - token-level pausing or transfer restrictions inside MINE may cause this
    ///   call to revert.
    /// - funding does not change any participant's reward entitlement.
    /// Funding events only describe transfers initiated through this function.
    ///
    /// @param amount Amount of MINE to deposit, using ERC20 smallest units.
    function fundRewards(
        uint256 amount
    )
        external
        nonReentrant
    {
        if (amount == 0) {
            revert ZeroFundingAmount();
        }

        mineToken.safeTransferFrom(
            msg.sender,
            address(this),
            amount
        );

        emit RewardsFunded(
            msg.sender,
            amount
        );
    }

    // =============================================================
    //                         CLAIM FUNCTION
    // =============================================================

    /// @notice Claims reward tokens owed to the caller by one registered service.
    /// @dev
    /// Claim behavior:
    /// - the caller selects which permanent service slot to use;
    /// - only registered slots are valid;
    /// - the external service computes and consumes the caller's claim;
    /// - this vault then transfers the returned amount to msg.sender;
    /// - the recipient address is never user-specified.
    ///
    /// Atomicity:
    /// - if the service call reverts, no token transfer occurs;
    /// - if the token transfer reverts, the service accounting is rolled back too;
    /// - if claimed is zero, no token transfer occurs and no payout event is emitted.
    ///
    /// Funding model:
    /// - both services draw from one shared live MINE balance;
    /// - the vault does not reserve liquidity per service or per participant;
    /// - if the vault is underfunded, the payout reverts.
    /// - a claim never deducts or transfers the user's staked principal.
    /// The vault records completed payments, not pending reward liabilities.
    /// The chosen service alone determines the reward quantity returned to the vault.
    ///
    /// @param slot Registered service slot to claim from.
    /// @return claimed Amount of MINE transferred to the caller.
    function claim(
        uint256 slot
    )
        external
        nonReentrant
        returns (
            uint256 claimed
        )
    {
        address staker =
            msg.sender;

        IStakingRewards accounting =
            _getRewardsContract(slot);

        claimed =
            accounting.consumeClaim(
                staker
            );

        if (claimed != 0) {
            totalDistributed +=
                claimed;

            mineToken.safeTransfer(
                staker,
                claimed
            );

            emit StakingRewardPaid(
                slot,
                staker,
                claimed
            );
        }
    }

    // =============================================================
    //                         VIEW FUNCTIONS
    // =============================================================

    /// @notice Returns the registered service address stored in one slot.
    /// @dev
    /// This function reverts if the requested slot has not yet been registered.
    /// It does not call the external service; it only returns the stored address.
    /// The result identifies an approved accounting source, not its current solvency.
    /// A valid slot does not imply that its service has any claimable rewards.
    ///
    /// @param slot Slot index to inspect.
    /// @return rewardsContract Registered staking reward service address.
    function getRewardsContract(
        uint256 slot
    )
        external
        view
        returns (
            address rewardsContract
        )
    {
        return
            address(_getRewardsContract(slot));
    }

    /// @notice Returns the current MINE balance held by the vault.
    /// @dev
    /// This is the live ERC20 balance at the vault address.
    /// It may differ from intended off-chain allocation plans.
    /// It is shared across all registered services.
    /// The balance may be lower than the sum of outstanding reward entitlements.
    /// The vault does not aggregate outstanding rewards across services.
    ///
    /// @return vaultTokenBalance Current reward token balance of the vault.
    function getVaultTokenBalance()
        external
        view
        returns (
            uint256 vaultTokenBalance
        )
    {
        return
            mineToken.balanceOf(
                address(this)
            );
    }

    // =============================================================
    //                          OWNERSHIP
    // =============================================================

    /// @notice Disables ownership renouncement.
    /// @dev
    /// Ownership may still be transferred through Ownable2Step.
    /// Renouncement is blocked so that still-empty service slots can be registered
    /// later if the project has not yet used both.
    /// Ownership changes do not alter existing registrations.
    /// A new owner may fill remaining slots, but cannot alter occupied ones.
    ///
    /// This function always reverts.
    function renounceOwnership()
        public
        view
        override
        onlyOwner
    {
        revert OwnershipRenounceDisabled();
    }

    // =============================================================
    //                       INTERNAL HELPERS
    // =============================================================

    /// @notice Resolves one registered service slot to its stored contract reference.
    /// @dev
    /// This helper ensures the requested slot is currently registered before
    /// returning the contract reference.
    /// Because the vault supports at most two permanent slots, any valid slot
    /// index is always within the fixed array bounds.
    /// Unregistered slot numbers cannot be used to call an arbitrary service.
    ///
    /// @param slot Slot index to resolve.
    /// @return accounting Registered staking reward service contract.
    function _getRewardsContract(
        uint256 slot
    )
        internal
        view
        returns (
            IStakingRewards accounting
        )
    {
        if (slot >= registeredRewardsCount) {
            revert InvalidRewardsSlot();
        }

        return
            _rewardsContracts[slot];
    }
}
